# Safe for browser bundles (set BEFORE building).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Optional tuning. Use the Supabase pooler and a small pool per Vercel instance.
DATABASE_POOL_MAX=4
# Prefer the provider CA if your connection requires a custom certificate.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Server-only Google service account; never use NEXT_PUBLIC_ for credentials.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Authenticate the hourly scheduler (configure the same secret in hosting).
CRON_SECRET=

# Server-only Google OAuth (personal account connection in Configuration).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-account/callback
# A base64-encoded random 32-byte encryption key. Keep stable; never expose it publicly.
GOOGLE_OAUTH_ENCRYPTION_KEY=
