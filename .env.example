# Safe for browser bundles (set BEFORE building).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Optional tuning. Use the Supabase pooler and a small pool per Vercel instance.
DATABASE_POOL_MAX=4
# Prefer the provider CA if your connection requires a custom certificate.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_SSL_REJECT_UNAUTHORIZED=false
